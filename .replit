modules = ["nodejs-20", "rust-stable", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["pkg-config", "glib", "gtk3", "webkitgtk_4_0", "libsoup_2_4", "zlib", "xorg.xorgserver", "xorg.xf86videodummy", "weston", "mesa"]

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
